# Local MongoDB example:
# MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas example (replace USER, PASSWORD, cluster host, and database name):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/learning_analytics?retryWrites=true&w=majority

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=learning_analytics
MONGODB_COLLECTION=student_interactions
